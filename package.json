{
  "name": "optiwork",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "demo": "turbo run dev --parallel --filter @optiwork/api --filter @optiwork/web",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "infra:up": "docker compose -f infra/docker-compose.yml --profile full up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml --profile full down",
    "local:up": "bash scripts/local.sh up",
    "local:down": "bash scripts/local.sh down",
    "local:status": "bash scripts/local.sh status",
    "local:e2e": "bash scripts/local.sh e2e"
  },
  "devDependencies": {
    "turbo": "2.5.6",
    "typescript": "5.9.3"
  }
}
