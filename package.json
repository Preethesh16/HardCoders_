{
  "name": "optiwork",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "demo": "turbo run dev --parallel --filter @optiwork/api --filter @optiwork/web --filter @optiwork/marketing",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "infra:up": "docker compose -f infra/docker-compose.yml --profile full up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml --profile full down",
    "local:up": "bash scripts/local.sh up",
    "local:down": "bash scripts/local.sh down",
    "local:status": "bash scripts/local.sh status",
    "local:e2e": "bash scripts/local.sh e2e",
    "testnet:up": "bash scripts/testnet.sh up",
    "testnet:down": "bash scripts/testnet.sh down",
    "testnet:status": "bash scripts/testnet.sh status",
    "testnet:e2e": "bash scripts/testnet.sh e2e",
    "hosted:preflight": "bash scripts/hosted.sh preflight",
    "hosted:up": "bash scripts/hosted.sh up",
    "hosted:status": "bash scripts/hosted.sh status",
    "hosted:logs": "bash scripts/hosted.sh logs",
    "hosted:down": "bash scripts/hosted.sh down",
    "hosted:backup": "bash scripts/hosted.sh backup",
    "test:browser:roles": "node scripts/verify-role-workflow-browser.mjs"
  },
  "devDependencies": {
    "turbo": "2.5.6",
    "typescript": "5.9.3"
  }
}
