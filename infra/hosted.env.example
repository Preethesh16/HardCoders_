# Copy to the repository root as .env.hosted and run chmod 600 .env.hosted.
# Never commit the populated file. Values below are placeholders, not defaults.

# Public HTTPS endpoint. Use a hostname only, without a scheme or path.
ANCHOR_DOMAIN=demo.example.com
ACME_EMAIL=operator@example.com

# The hosted hackathon demo is protected at the reverse proxy because the
# application workflow intentionally retains guarded demo principals.
ANCHOR_BASIC_AUTH_USER=anchor-demo
# Generate with: docker run --rm caddy:2.10.2-alpine caddy hash-password --plaintext 'LONG_RANDOM_PASSWORD'
# Single-quote the bcrypt value when placing it in .env.hosted.
ANCHOR_BASIC_AUTH_HASH='$2a$14$REPLACE_WITH_A_REAL_BCRYPT_HASH'

# Supabase session-pooler URI on port 5432, with no query or fragment.
SUPABASE_DATABASE_URL=postgresql://postgres.PROJECT_REF:ROTATED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Private object storage. Generate both values independently.
MINIO_ROOT_USER=REPLACE_WITH_RANDOM_ACCESS_KEY
MINIO_ROOT_PASSWORD=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
S3_BUCKET=anchor-documents

# Live adapters used by the demonstration.
AI_MODE=openai
OPENAI_API_KEY=REPLACE_WITH_SCOPED_OPENAI_KEY
FX_MODE=frankfurter
REGULATION_REFRESH_MODE=live
