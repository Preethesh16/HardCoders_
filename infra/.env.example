# Local infrastructure. Copy to infra/.env, which is never committed.
# Every value below is a well-known local development credential. A hosted
# deployment must replace all of them and must not reuse any of them.

OPTIWORK_PROFILE=local

POSTGRES_USER=optiwork
POSTGRES_PASSWORD=optiwork-local-development
POSTGRES_DB=optiwork
POSTGRES_PORT=5432

MINIO_ROOT_USER=optiwork
MINIO_ROOT_PASSWORD=optiwork-local-development
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=optiwork-documents
STORAGE_MODE=s3

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=optiwork-local-development
KEYCLOAK_PORT=18080
# `demo` accepts a local principal token so the walkthrough runs with no IdP.
# Switch to `oidc` once the realm is imported and users have been created.
AUTH_MODE=demo

API_PORT=4000
WEB_PORT=3000

FX_MODE=frankfurter
# Use `openai` for live advisory shortlisting/drafting/validation. The adapter
# visibly falls back to a recorded fixture if the provider is unavailable.
AI_MODE=fixture
# Provide a key through the environment or a secret manager. Never commit one.
# OPENAI_API_KEY=

# Public TestNet only: Supabase session-pooler connection URI on port 5432,
# without query parameters. Keep the real value only in the ignored root .env.
# SUPABASE_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

ALGORAND_MODE=simulated
ALGORAND_NETWORK=localnet
ALGORAND_EXPLORER_BASE_URL=https://lora.algokit.io/testnet
EXECUTOR_PORT=4301
# Required only when ALGORAND_MODE=executor.
# ALGORAND_EXECUTOR_TOKEN=

FABRIC_MODE=mock
FABRIC_EVIDENCE_MODE=mock
