# OptiWork API. Copy to an untracked .env. Never commit a real key or secret.
# The demo profile needs none of these: it runs fully offline with deterministic
# FX fixtures, recorded AI fixtures, an in-memory marketplace and object store,
# a simulated Algorand executor and a mock FabricEvidenceReader.

# demo | local | testnet
OPTIWORK_PROFILE=demo
API_HOST=127.0.0.1
API_PORT=4000
OPTIWORK_VERSION=0.1.0

# ---------------------------------------------------------------------------
# PostgreSQL 17. Required outside the demo profile.
# ---------------------------------------------------------------------------
# DATABASE_URL=postgresql://optiwork:<local-password>@127.0.0.1:5432/optiwork

# ---------------------------------------------------------------------------
# Identity. AUTH_MODE=demo accepts a local principal token and is refused for a
# hosted deployment; AUTH_MODE=oidc validates Keycloak-issued access tokens.
# ---------------------------------------------------------------------------
AUTH_MODE=demo
# OIDC_ISSUER=http://127.0.0.1:18080/realms/optiwork
# OIDC_AUDIENCE=optiwork-api
# OIDC_JWKS_URI=http://127.0.0.1:18080/realms/optiwork/protocol/openid-connect/certs
# OIDC_ROLES_CLAIM=roles

# ---------------------------------------------------------------------------
# Object storage. MinIO locally, any S3-compatible service when hosted.
# ---------------------------------------------------------------------------
STORAGE_MODE=memory
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_REGION=us-east-1
# S3_BUCKET=optiwork-documents
# S3_ACCESS_KEY_ID=<minio-access-key>
# S3_SECRET_ACCESS_KEY=<minio-secret-key>
S3_SIGNED_URL_TTL_SECONDS=300

# ---------------------------------------------------------------------------
# FX. `fixture` is deterministic and offline. `frankfurter` reads ECB reference
# rates and falls back to the fixture if the service is unreachable.
# ---------------------------------------------------------------------------
FX_MODE=fixture
# FX_FRANKFURTER_URL=https://api.frankfurter.app
FX_QUOTE_TTL_SECONDS=900

# ---------------------------------------------------------------------------
# AI. Advisory only: it can never approve an identity, change a compliance
# decision, approve work, or authorize or release escrow. With no key the
# recorded fixtures are used and the demo is fully functional.
# ---------------------------------------------------------------------------
AI_MODE=fixture
# OPENAI_API_KEY=<provided-later-never-commit>
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4.1-mini

# ---------------------------------------------------------------------------
# Algorand. `simulated` runs the escrow state machine in process. `executor`
# calls the isolated executor service, which owns every signing key. MainNet is
# refused by the executor's own configuration.
# ---------------------------------------------------------------------------
ALGORAND_MODE=simulated
ALGORAND_NETWORK=localnet
# ALGORAND_EXECUTOR_URL=http://127.0.0.1:4301
# ALGORAND_EXECUTOR_TOKEN=<executor-workload-token>
ALGORAND_EXPLORER_BASE_URL=https://lora.algokit.io/testnet

# ---------------------------------------------------------------------------
# Hyperledger Fabric. Owned by a separate workstream. `mock` records work
# commitments in process and mirrors approved versions to the shared fixture
# file the Algorand executor re-reads before it signs a release.
# ---------------------------------------------------------------------------
FABRIC_MODE=mock
FABRIC_EVIDENCE_FIXTURE_PATH=./.optiwork/fabric-evidence.json
# FABRIC_GATEWAY_URL=http://127.0.0.1:4200
