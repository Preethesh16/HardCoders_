{
  "name": "@optiwork/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --import tsx --watch src/server.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "test": "vitest run src --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.734.0",
    "@aws-sdk/s3-request-presigner": "3.734.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/type-provider-typebox": "5.2.0",
    "@optiwork/contracts": "workspace:*",
    "@optiwork/domain": "workspace:*",
    "@sinclair/typebox": "0.34.52",
    "drizzle-orm": "0.44.6",
    "fastify": "5.12.1",
    "jose": "6.2.10",
    "json-canonicalize": "2.0.0",
    "pg": "8.16.3",
    "pino": "10.3.1"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pg": "8.15.4",
    "drizzle-kit": "0.31.6",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
