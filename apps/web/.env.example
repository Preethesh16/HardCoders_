# OptiWork web. Copy to an untracked .env.local. Never put a secret here:
# every value in this file is compiled into the browser bundle.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:4000
NEXT_PUBLIC_ALGORAND_EXPLORER_BASE_URL=https://lora.algokit.io/testnet
NEXT_PUBLIC_DEMO_LABEL=DEMONSTRATION ONLY

# Server-side only. The browser never receives a bearer token, a private key,
# a mnemonic or any blockchain signing control.
OPTIWORK_API_BASE_URL=http://127.0.0.1:4000
