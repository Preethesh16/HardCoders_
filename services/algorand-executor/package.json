{
  "name": "@optiwork/algorand-executor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "compile:contract": "puya-ts contracts/optiwork-escrow.algo.ts --out-dir artifacts --output-arc32 --output-source-map --output-teal",
    "deploy:localnet": "pnpm compile:contract && node --env-file-if-exists=.env.deploy --import tsx src/deploy-localnet.ts",
    "deploy:testnet": "pnpm compile:contract && node --env-file-if-exists=.env.testnet --import tsx src/deploy-testnet.ts",
    "generate:testnet-accounts": "node --import tsx src/generate-testnet-accounts.ts",
    "dev": "node --env-file-if-exists=.env --watch --import tsx src/server.ts",
    "lint": "tsc --noEmit",
    "start": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "start:prod": "node dist/server.js",
    "test": "vitest run --exclude test/localnet/** --exclude test/testnet/**",
    "test:contract": "vitest run test/contract.test.ts",
    "test:localnet": "pnpm compile:contract && vitest run test/localnet --testTimeout=240000",
    "test:testnet": "OPTIWORK_TESTNET_E2E=1 vitest run test/testnet --testTimeout=900000",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm compile:contract && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@algorandfoundation/algokit-utils": "9.2.0",
    "@fastify/helmet": "13.0.2",
    "@fastify/rate-limit": "10.3.0",
    "algosdk": "3.7.0",
    "fastify": "5.12.1",
    "jose": "6.2.10",
    "json-canonicalize": "2.0.0",
    "pg": "8.23.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@algorandfoundation/algorand-typescript": "1.3.0",
    "@algorandfoundation/algorand-typescript-testing": "1.2.0",
    "@algorandfoundation/puya-ts": "1.3.0",
    "@rollup/plugin-typescript": "12.3.0",
    "@types/node": "24.3.0",
    "@types/pg": "8.23.1",
    "tsx": "4.20.5",
    "tslib": "2.8.1",
    "typescript": "5.9.2",
    "vitest": "3.2.6"
  }
}
