# Runtime service. Copy to an untracked .env and inject all secrets through a
# local secret file or secret manager. Never commit real bearer tokens, JWKs,
# private keys, wallet mnemonics, or database passwords.
HOST=127.0.0.1
PORT=4301
LOG_LEVEL=info
EXECUTOR_BEARER_TOKEN=<random-32-or-more-character-workload-token>
# Query parameters are forbidden. Remote database hosts require
# DATABASE_SSL_MODE=verify-full; disable/require are accepted only on loopback.
DATABASE_URL=postgresql://optiwork_executor:<local-password>@127.0.0.1:5432/optiwork_algorand
DATABASE_SSL_MODE=disable
DATABASE_AUTO_MIGRATE=false
DATABASE_DEAL_LOCK_TIMEOUT_MS=120000

FABRIC_GATEWAY_URL=http://127.0.0.1:4200
# Preferred staging path: the local Keycloak bootstrap provisions this
# confidential service account with the `optiwork-fabric-gateway` audience and
# the `optiwork-payments` subject. Keep its secret untracked.
FABRIC_GATEWAY_BEARER_TOKEN=
FABRIC_GATEWAY_OIDC_TOKEN_URL=http://127.0.0.1:18080/realms/optiwork/protocol/openid-connect/token
FABRIC_GATEWAY_OIDC_CLIENT_ID=optiwork-algorand-executor
FABRIC_GATEWAY_OIDC_CLIENT_SECRET=<generated-local-keycloak-client-secret>
FABRIC_GATEWAY_OIDC_SCOPE=
FABRIC_GATEWAY_OIDC_REFRESH_SKEW_SECONDS=30
FABRIC_GATEWAY_TIMEOUT_MS=3000
FABRIC_PERMIT_ISSUER=optiwork-fabric-gateway
FABRIC_PERMIT_AUDIENCE=optiwork-algorand-executor
FABRIC_PERMIT_PUBLIC_JWK_JSON={"kty":"OKP","crv":"Ed25519","alg":"EdDSA","use":"sig","kid":"localnet-permit-1","x":"<base64url-public-key>"}
FABRIC_PERMIT_MAX_AGE_SECONDS=60
ALGORAND_RELEASE_SAFETY_MARGIN_SECONDS=30

# Approved-work-evidence source. `gateway` reads the real Fabric Gateway
# projection. `mock` reads a shared JSON fixture and is refused on TestNet; it
# exists so the offline demo runs with no Fabric network. The API writes the
# fixture; the executor only reads it.
FABRIC_EVIDENCE_MODE=gateway
# FABRIC_EVIDENCE_FIXTURE_PATH=/var/lib/optiwork/fabric-evidence.json

ALGORAND_NETWORK=localnet
ALGORAND_ALGOD_URL=http://127.0.0.1:4001
ALGORAND_ALGOD_TOKEN=<localnet-algod-token>
ALGORAND_REQUEST_TIMEOUT_MS=15000
ALGORAND_CONFIRMATION_ROUNDS=12
# Per-transaction fail-closed cap, including the doubled app-call fee for one
# inner payment/asset transfer.
ALGORAND_MAX_TRANSACTION_FEE_MICROALGOS=10000
ALGORAND_MAX_GROUP_FEE_MICROALGOS=20000
ALGORAND_GENESIS_HASH=<base64-genesis-hash>
ALGORAND_APPLICATION_ID=<deployed-positive-app-id>
# LocalNet: the OptiUSD-DEMO ASA minted by `pnpm deploy:localnet` (six decimals).
# TestNet: must be exactly 10458941, Circle's official zero-value USDC ASA.
ALGORAND_ASSET_ID=<localnet-optiusd-demo-asset-id>
ALGORAND_SIGNER_ADDRESS=<executor-creator-address>
ALGORAND_SIGNER_PRIVATE_KEY_BASE64=<64-byte-private-key-base64>
ALGORAND_ORIGIN_PROVIDER_TREASURY_ADDRESS=<distinct-origin-provider-treasury-address>
ALGORAND_ORIGIN_PROVIDER_TREASURY_PRIVATE_KEY_BASE64=<distinct-64-byte-private-key-base64>
ALGORAND_MAX_VALIDITY_ROUNDS=100

# One-shot LocalNet deployer. Put these values in an untracked .env.deploy.
# The explicit confirmation prevents an accidental application deployment.
# ALGORAND_DEPLOY_CONFIRM=DEPLOY_LOCALNET_ESCROW
# ALGORAND_DEPLOY_ALGOD_URL=http://127.0.0.1:4001
# ALGORAND_DEPLOY_ALGOD_TOKEN=<localnet-algod-token>
# ALGORAND_DEPLOY_GENESIS_HASH=<base64-genesis-hash>
# Leave unset to mint the zero-value OptiUSD-DEMO ASA with six decimals.
# ALGORAND_DEPLOY_ASSET_ID=<existing-six-decimal-localnet-asa-id>
# ALGORAND_DEPLOY_EXECUTOR_ADDRESS=<funded-executor-address>
# ALGORAND_DEPLOY_EXECUTOR_PRIVATE_KEY_BASE64=<64-byte-private-key-base64>
# ALGORAND_DEPLOY_APP_FUNDING_MICROALGOS=5000000

# ---------------------------------------------------------------------------
# Public Algorand TestNet — DUMMY FUNDS, NO MONETARY VALUE
# ---------------------------------------------------------------------------
# TestNet is a separate, explicit path. It never reuses the LocalNet deployer
# and never accepts a loopback endpoint or a static bearer token. MainNet and
# BetaNet are refused by pinned genesis hash and genesis ID.
#
# Runtime service on TestNet (all HTTPS, OIDC only):
# ALGORAND_NETWORK=testnet
# ALGORAND_ALGOD_URL=https://testnet-api.algonode.cloud
# ALGORAND_INDEXER_URL=https://testnet-idx.algonode.cloud
# ALGORAND_GENESIS_HASH=SGO1GKSzyE7IEPItTxCByw9x8FmnrCDexi9/cOUJOiI=
# ALGORAND_CONFIRMATION_ROUNDS=20
# Circle's official TestNet USDC ASA. Any other value is refused.
# ALGORAND_ASSET_ID=10458941
#
# Step 1 — generate disposable TestNet accounts. Writes owner-only (0600) key
# material to the ignored path below and prints only public addresses.
#   ALGORAND_TESTNET_ACCOUNTS_CONFIRM=GENERATE_TESTNET_ACCOUNTS \
#   corepack pnpm generate:testnet-accounts
# ALGORAND_TESTNET_ACCOUNTS_PATH=generated-credentials/testnet-accounts.json
#
# Step 2 — fund ONLY the printed deployer address with dummy TestAlgos from the
# official dispenser at https://bank.testnet.algorand.network/ (5 ALGO minimum),
# then obtain zero-value TestNet USDC for the origin provider treasury from
# Circle's TestNet faucet. The deployer opts treasuries into ASA 10458941 but
# never mints or transfers it.
# Never send real funds. Never share or transmit a mnemonic or private key.
#
# Step 3 — deploy. Put these in an untracked .env.testnet. The confirmation
# token is deliberately different from the LocalNet one.
# ALGORAND_DEPLOY_CONFIRM=DEPLOY_TESTNET_ESCROW
# ALGORAND_DEPLOY_ALGOD_URL=https://testnet-api.algonode.cloud
# ALGORAND_DEPLOY_APP_FUNDING_MICROALGOS=2000000
# ALGORAND_TESTNET_MANIFEST_PATH=testnet/deployment-manifest.json
