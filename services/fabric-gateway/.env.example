APP_MODE=demo
FABRIC_MODE=memory
HOST=127.0.0.1
PORT=4200
LOG_LEVEL=info

FABRIC_CHANNEL_NAME=optiwork-channel
FABRIC_CHAINCODE_NAME=optiwork-evidence

# Real mode only. These are server-side enrollment paths. Certificates must
# carry optiwork.role=seller or optiwork.role=buyer as appropriate.
# FABRIC_MODE=real
# FABRIC_IDENTITIES_JSON=[{"role":"seller","mspId":"SellerOrgMSP","certificatePath":"/run/secrets/fabric/seller-cert.pem","privateKeyPath":"/run/secrets/fabric/seller-key.pem","tlsRootCertificatePath":"/run/secrets/fabric/peer-tls-ca.pem","peerEndpoint":"127.0.0.1:9051","tlsServerName":"peer0.seller.optiwork.local"},{"role":"buyer","mspId":"BuyerOrgMSP","certificatePath":"/run/secrets/fabric/buyer-cert.pem","privateKeyPath":"/run/secrets/fabric/buyer-key.pem","tlsRootCertificatePath":"/run/secrets/fabric/peer-tls-ca.pem","peerEndpoint":"127.0.0.1:8051","tlsServerName":"peer0.buyer.optiwork.local"}]

# Demo creates an ephemeral Ed25519 permit key. Production must inject a private
# JWK through a secret manager; never commit it.
FABRIC_PERMIT_ISSUER=optiwork-fabric-gateway
FABRIC_PERMIT_AUDIENCE=optiwork-algorand-executor
FABRIC_PERMIT_KEY_ID=optiwork-local-permit-1
FABRIC_PERMIT_TTL_SECONDS=60
# FABRIC_PERMIT_PRIVATE_JWK_JSON={"kty":"OKP","crv":"Ed25519","d":"<secret>","x":"<public>","kid":"optiwork-permit-1"}

IDEMPOTENCY_STORE=memory
IDEMPOTENCY_TTL_MS=900000
IDEMPOTENCY_MAX_ENTRIES=10000
IDEMPOTENCY_AUTO_MIGRATE=false
# IDEMPOTENCY_STORE=postgres
# IDEMPOTENCY_DATABASE_URL=postgresql://optiwork_gateway:<local-password>@127.0.0.1:5432/optiwork

# Production Keycloak/OIDC boundary.
# APP_MODE=production
# OIDC_ISSUER=http://127.0.0.1:18080/realms/optiwork
# OIDC_AUDIENCE=optiwork-fabric-gateway
# OIDC_JWKS_URL=http://127.0.0.1:18080/realms/optiwork/protocol/openid-connect/certs
