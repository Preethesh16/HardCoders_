{
  "name": "@optiwork/fabric-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/type-provider-typebox": "5.2.0",
    "@grpc/grpc-js": "1.14.4",
    "@hyperledger/fabric-gateway": "1.12.0",
    "@optiwork/contracts": "workspace:*",
    "@sinclair/typebox": "0.34.52",
    "fastify": "5.12.1",
    "jose": "6.1.0",
    "json-canonicalize": "3.0.0",
    "pg": "8.16.3",
    "pino": "10.3.1"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pg": "8.15.5",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
